<% content_for :title, 'Editing question' %>

<h1>Editing question</h1>

<%= bootstrap_form_with model: @question, method: :patch, url: question_path(@question) do |f| %>
  <%= f.text_field :stem %>
  <%= f.text_field :answer %>
  <%= f.text_field :distractor_1 %>
  <%= f.text_field :distractor_2 %>
  <%= f.submit class: 'btn btn-primary' %>
<% end %>

<br>

<div>
  <%= link_to 'Show this question', question_path(@question) %> |
  <%= link_to 'Back to questions', questions_path %>
</div>
