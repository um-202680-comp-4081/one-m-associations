<% content_for :title, 'Editing question' %>

<h1>Editing question</h1>

<%= bootstrap_form_with model: @question, method: :patch, url: quiz_question_path(@quiz, @question) do |f| %>
  <%= f.text_field :stem %>
  <%= f.text_field :answer %>
  <%= f.text_field :distractor_1 %>
  <%= f.text_field :distractor_2 %>
  <%= f.submit class: 'btn btn-primary' %>
<% end %>

<br>

<div>
  <%= link_to 'Show this question', quiz_question_path(@quiz, @question) %> |
  <%= link_to 'Back to questions', quiz_questions_path(@quiz) %>
</div>
