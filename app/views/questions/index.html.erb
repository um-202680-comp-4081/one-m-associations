<h1>Questions</h1>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">

    <thead class="table-dark">
      <tr>
        <th>Stem</th>
        <th></th>
      </tr>
    </thead>

    <tbody>
      <% @questions.each do |question| %>
        <tr>
          <td><%= question.stem %></td>
          <td class="text-nowrap">
            <%= link_to 'show', quiz_question_path(@quiz, question), class: 'btn btn-sm btn-outline-primary' %>
            <%= link_to 'edit', edit_quiz_question_path(@quiz, question), class: 'btn btn-sm btn-outline-primary' %>
            <%= button_to 'destroy', quiz_question_path(@quiz, question), method: :delete, class: 'btn btn-sm btn-outline-primary', form: { class: 'd-inline' } %>
          </td>
        </tr>
      <% end %>
    </tbody>

  </table>
</div>

<p>
  <%= link_to 'New Question', new_quiz_question_path(@quiz), class: 'btn btn-primary' %>
</p>
