<div id="<%= dom_id @question %>">
  <p>
    <strong><%= @question.stem %></strong>
  </p>

  <p>
    <strong>Answer:</strong>
    <%= @question.answer %>
  </p>

  <p>
    <strong>Distractor 1:</strong>
    <%= @question.distractor_1 %>
  </p>

  <p>
    <strong>Distractor 2:</strong>
    <%= @question.distractor_2 %>
  </p>

</div>

<div>
  <%= link_to 'Edit this question', edit_quiz_question_path(@quiz, @question) %> |
  <%= link_to 'Back to questions', quiz_questions_path(@quiz) %>

  <%= button_to 'Destroy this question', quiz_question_path(@quiz, @question), method: :delete %>
</div>
